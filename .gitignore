# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Environment
.env

# Runtime state — written by the running bot, never source.
# Committing these is not just noise: the deploy ships the repo, so a
# tracked database means every release overwrites weeks of accumulated
# results with whatever snapshot happened to be committed. The -wal and
# -shm files are worse, being a half-applied transaction log.
data/paper_metrics.jsonl
data/predictions.jsonl
data/signals_taken.jsonl

# Guardrail markers (execution/guardrails.py). A committed KILL_SWITCH or
# TRADING_ARMED would mean every fresh deploy inherits whatever state this
# machine happened to be in — the opposite of the fail-safe default.
data/KILL_SWITCH
data/TRADING_ARMED

# Re-downloadable probe cache. scripts/probe_1min.py refetches it when
# absent, so committing half a megabyte of candles buys nothing.
data/history/btc_1m_probe.json
data/*.db
data/*.db-wal
data/*.db-shm

# data/history/ is deliberately NOT ignored: the 299-window BTC dataset the
# backtest runs against is research input, and it is committed on purpose.

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
