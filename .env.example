# Polymarket CLOB API
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_CLOB_URL=https://clob.polymarket.com

# Wallet (Polygon)
PRIVATE_KEY=
WALLET_ADDRESS=

# External price feeds
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# Bot configuration
TRADING_MODE=paper
LOG_LEVEL=INFO

# Safety guardrails (src/moneyclush/execution/guardrails.py). Order size
# and max exposure are a % of the live on-chain balance, not a flat
# dollar figure, so they grow with the account and — the important part
# — shrink again on their own after a loss. max_order_usd is a separate
# absolute backstop, not the sizing target.
MONEYCLUSH_ORDER_FRACTION=0.25
MONEYCLUSH_MAX_ORDER_USD=10.0
MONEYCLUSH_MAX_OPEN_EXPOSURE_FRACTION=0.5
MONEYCLUSH_MAX_DAILY_LOSS_USD=3.0
MONEYCLUSH_MAX_ORDERS_PER_HOUR=10
MONEYCLUSH_MIN_SECONDS_REMAINING=30.0
MONEYCLUSH_BALANCE_BUFFER_USD=0.05

# Persistence — MONEYCLUSH_DB must point at a mounted volume, not just any
# path, or storage silently reports "ephemeral" and the boot alert says so.
MONEYCLUSH_DB=/data/moneyclush.db

# Web Push (arbitrage, BTC edge, storage warnings, strong favourites).
# Generate once with: python -c "from py_vapid import Vapid; v=Vapid();
# v.generate_keys(); print(v.private_pem().decode())"
# Left unset, a key is generated per process — fine for local testing,
# but every browser subscription breaks on the next restart because the
# public key it was issued against no longer matches.
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:you@example.com
